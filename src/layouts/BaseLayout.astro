---
// Self-hosted so the site renders identically where Google Fonts is unreachable.
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  canonical = site.website,
  image = `${site.website}avatar.png`
} = Astro.props;

const publications = site.work.filter((item) => item.type === 'publication');

const person = {
  '@type': 'Person',
  '@id': `${site.website}#person`,
  name: site.name,
  alternateName: [site.chineseName, 'Du Kang'],
  url: site.website,
  image,
  email: site.email,
  jobTitle: site.title,
  description: site.description,
  knowsAbout: site.researchAreas,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: 'The Hong Kong University of Science and Technology (Guangzhou)',
    url: 'https://www.hkust-gz.edu.cn/'
  },
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'The University of Hong Kong' },
    { '@type': 'CollegeOrUniversity', name: 'Texas A&M University' }
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.location
  },
  sameAs: [site.links.scholar, site.links.github, site.links.linkedin].filter(Boolean)
};

const namedAuthors = (authors?: string) => {
  const names = (authors ?? site.name)
    .split(',')
    .map((n) => n.trim())
    .filter((n) => n && !n.toLowerCase().includes('collaborator'));
  return (names.length ? names : [site.name]).map((name) => ({ '@type': 'Person', name }));
};

const scholarlyArticles = publications.map((pub) => ({
  '@type': 'ScholarlyArticle',
  name: pub.fullTitle ?? pub.title,
  author: namedAuthors(pub.authors),
  datePublished: pub.period,
  publication: pub.venue,
  ...(pub.links?.paper ? { url: pub.links.paper } : {}),
  ...(pub.links?.code ? { codeRepository: pub.links.code } : {})
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': site.website,
      url: site.website,
      name: title,
      description,
      inLanguage: 'en',
      mainEntity: { '@id': `${site.website}#person` }
    },
    person,
    ...scholarlyArticles
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.seo.keywords.join(', ')} />
    <meta name="author" content={`${site.name} (${site.chineseName})`} />
    <link rel="canonical" href={canonical} />

    <meta
      name="robots"
      content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"
    />
    <meta name="googlebot" content="index,follow" />
    <meta name="bingbot" content="index,follow" />
    <meta name="baiduspider" content="index,follow" />

    <!-- Baidu treats these as mobile-adaptation and rendering hints -->
    <meta name="applicable-device" content="pc,mobile" />
    <meta http-equiv="Cache-Control" content="no-transform" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={`${site.name} (${site.chineseName})`} />
    <meta property="og:site_name" content={`${site.name} · ${site.chineseName}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="zh_CN" />
    <meta property="profile:first_name" content="Kang" />
    <meta property="profile:last_name" content="Du" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <meta name="theme-color" content="#1b4f93" />
    <link rel="icon" type="image/png" href="/avatar.png" />
    <link rel="apple-touch-icon" href="/avatar.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <slot />

    <script>
      const targets = document.querySelectorAll('.reveal');
      if (!window.IntersectionObserver) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -12% 0px' }
        );
        targets.forEach((el) => observer.observe(el));
      }

      // iOS Safari refuses to autoplay a video it considers invisible, and the
      // reveal animation starts every section at opacity 0. So drive playback
      // ourselves once each clip is actually on screen, and fall back to native
      // controls if the browser still says no (e.g. Low Power Mode).
      const clips = document.querySelectorAll('.work-thumb video');

      const start = (video: HTMLVideoElement, retry = true) => {
        video.muted = true;
        const attempt = video.play();
        if (attempt && typeof attempt.catch === 'function') {
          attempt.catch(() => {
            if (retry) {
              setTimeout(() => start(video, false), 400);
            } else {
              video.controls = true;
            }
          });
        }
      };

      if (!window.IntersectionObserver) {
        clips.forEach((video) => start(video as HTMLVideoElement));
      } else {
        const player = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const video = entry.target as HTMLVideoElement;
              if (entry.isIntersecting) {
                start(video);
              } else if (!video.paused) {
                video.pause();
              }
            });
          },
          { threshold: 0.25 }
        );
        clips.forEach((video) => player.observe(video));
      }

      // A tap should always be able to start playback.
      clips.forEach((el) => {
        const video = el as HTMLVideoElement;
        video.addEventListener('click', () => {
          if (video.paused) start(video, false);
        });
      });
    </script>
  </body>
</html>
