---
import { site } from '../data/site';
import Section from './Section.astro';
---

<Section id="about" index="01" title="Short Bio">
  <div class="about-bio">
    {site.longBio.map((paragraph) => <p set:html={paragraph} />)}
  </div>

  <p class="areas">
    <strong>Research areas:</strong>
    {site.researchAreas.join(' · ')}
  </p>
</Section>
