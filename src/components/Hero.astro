---
import { site } from '../data/site';
---

<header class="top-row" id="top">
  <div class="profile">
    <img class="avatar" src="/avatar.png" alt={site.name} />
    <div>
      <h1>
        {site.name} <span class="cn">{site.chineseName}</span>
      </h1>
      <p class="role">{site.title}</p>
      <p class="affil">{site.affiliation}</p>
      <p class="profile-links">
        <a href={site.links.email}>Email</a>
        <a href={site.links.scholar}>Google Scholar</a>
        <a href={site.links.github}>GitHub</a>
        <a href={site.links.linkedin}>LinkedIn</a>
        <a href={site.links.cv}>CV</a>
      </p>
    </div>
  </div>

  <div class="top-experience">
    <p class="subhead">Experience</p>
    <ul class="exp-list">
      {
        site.experience.map((item) => (
          <li>
            <span class="exp-period">{item.period}</span>
            <span>
              {item.role}, {item.url ? <a href={item.url}>{item.organization}</a> : item.organization}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</header>
