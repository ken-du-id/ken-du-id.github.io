---
import Section from './Section.astro';
import { publicationsByYear } from '../data/site';

const grouped = publicationsByYear.reduce<Record<string, typeof publicationsByYear>>((acc, pub) => {
  const key = String(pub.year);
  acc[key] ??= [];
  acc[key].push(pub);
  return acc;
}, {});
const years = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));
---

<Section
  id="publications"
  title="Publications"
  intro="Full publication list grouped by year. Public links are filled where available."
>
  <div class="pub-groups">
    {
      years.map((year) => (
        <section class="pub-year-group">
          <div class="year-tag">{year}</div>
          <div class="pub-stack">
            {grouped[year].map((pub) => (
              <article class="pub-item">
                <div class="pub-heading">
                  <h3>{pub.title}</h3>
                  <span class:list={{ badge: true, muted: !pub.status }}>{pub.status ?? pub.venue}</span>
                </div>
                <p class="pub-authors">{pub.authors}</p>
                <p class="pub-meta">
                  <span>{pub.venue}</span>
                  <span>{pub.year}</span>
                </p>
                {pub.description && <p class="pub-desc">{pub.description}</p>}
                <div class="item-links">
                  {pub.links?.paper && <a href={pub.links.paper}>Paper</a>}
                  {pub.links?.code && <a href={pub.links.code}>Code</a>}
                  {pub.links?.project && <a href={pub.links.project}>Project</a>}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Section>
