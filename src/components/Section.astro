---
interface Props {
  id: string;
  title: string;
  index?: string;
  intro?: string;
}

const { id, title, index, intro } = Astro.props;
---

<section id={id} class="section reveal">
  <div class="section-head">
    {index && <span class="section-index">{index}</span>}
    <h2>{title}</h2>
  </div>
  {intro && <p class="section-intro">{intro}</p>}
  <slot />
</section>
