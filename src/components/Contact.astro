---
import Section from './Section.astro';
import { site } from '../data/site';
---

<Section id="contact" index="03" title="Contact">
  <div class="contact-body">
    <p>
      Feel free to reach out if you are interested in inverse rendering, editable world models, simulation for
      robotics, or related collaboration.
    </p>
    <p class="contact-emails">
      {site.email}<br />
      {site.secondaryEmail}
    </p>
    <p>
      <a href={site.links.email}>Email</a> ·
      <a href={site.links.scholar}>Google Scholar</a> ·
      <a href={site.links.github}>GitHub</a> ·
      <a href={site.links.linkedin}>LinkedIn</a> ·
      <a href={site.links.cv}>CV</a>
    </p>
  </div>
</Section>
