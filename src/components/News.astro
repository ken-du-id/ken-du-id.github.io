---
import Section from './Section.astro';
import { site } from '../data/site';
---

<Section id="news" title="News" intro="Recent milestones and updates.">
  <ul class="news-list">
    {site.news.map((item) => (
      <li>
        <span>{item.date}</span>
        <p>{item.text}</p>
      </li>
    ))}
  </ul>
</Section>
